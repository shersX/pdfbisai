# 阿里云百炼 / DashScope API Key
DASHSCOPE_API_KEY=sk-xxxxxxxx

# DashScope HTTP Base URL（国内默认如下；国际站可改为 https://dashscope-intl.aliyuncs.com/api/v1）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 多模态模型，推荐：qwen-vl-max / qwen-vl-plus / qwen3-vl-plus
QWEN_VL_MODEL=qwen-vl-max

# PDF 最多送入模型的页数（从第 1 页起）
MAX_PDF_PAGES=8

# 单页渲染缩放，越大越清晰也越费 token
PDF_ZOOM=2.0

# 大模型并发数
MAX_WORKERS=3
